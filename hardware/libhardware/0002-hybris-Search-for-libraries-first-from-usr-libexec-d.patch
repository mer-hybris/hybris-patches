From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matti Lehtimaki <matti.lehtimaki@gmail.com>
Date: Wed, 5 Aug 2015 14:31:01 +0200
Subject: [PATCH] (hybris) Search for libraries first from
 /usr/libexec/droid-hybris/system/lib/hw/.

Change-Id: I7496d961f8218b6077b9d628dd350ac20550b5d2
---
 hardware.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/hardware.c b/hardware.c
index 94b5d5d33ea2190a75d6627e5586606c315da0b5..da0c184a88801c53234a7a18f126da261a1d541e 100644
--- a/hardware.c
+++ b/hardware.c
@@ -48,6 +48,7 @@
 #define HAL_LIBRARY_PATH1 "/system/" HAL_LIBRARY_SUBDIR
 #define HAL_LIBRARY_PATH2 "/vendor/" HAL_LIBRARY_SUBDIR
 #define HAL_LIBRARY_PATH3 "/odm/" HAL_LIBRARY_SUBDIR
+#define HAL_LIBRARY_PATH4 "/usr/libexec/droid-hybris/system/" HAL_LIBRARY_SUBDIR
 
 /**
  * There are a set of variant filename for modules. The form of the filename
@@ -194,6 +195,11 @@ static int hw_module_exists(char *path, size_t path_len, const char *name,
     ALOGE("hw_module_exists: libapexsupport is not supported in %d.", __ANDROID_VENDOR_API__);
 #endif // __ANDROID_VENDOR_API__
 #else // __ANDROID_APEX__
+    snprintf(path, path_len, "%s/%s.%s.so",
+             HAL_LIBRARY_PATH4, name, subname);
+    if (path_in_path(path, HAL_LIBRARY_PATH4) && access(path, R_OK) == 0)
+        return 0;
+
     snprintf(path, path_len, "%s/%s.%s.so",
              HAL_LIBRARY_PATH3, name, subname);
     if (path_in_path(path, HAL_LIBRARY_PATH3) && access(path, R_OK) == 0)
