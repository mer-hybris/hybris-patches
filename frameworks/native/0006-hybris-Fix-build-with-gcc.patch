From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matti Lehtimaki <matti.lehtimaki@gmail.com>
Date: Thu, 11 Jul 2024 21:44:45 +0300
Subject: [PATCH] (hybris) Fix build with gcc

Change-Id: I4ab6398977d58dc19794fe085d0b2687f399aa53
---
 libs/nativewindow/include/android/data_space.h    | 2 +-
 libs/nativewindow/include/android/native_window.h | 4 +++-
 libs/nativewindow/include/vndk/hardware_buffer.h  | 2 +-
 3 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/libs/nativewindow/include/android/data_space.h b/libs/nativewindow/include/android/data_space.h
index 295a307c3cf8c7e8030b36bb2c869f7caa06d185..c54fe548d87e9aca48f496d9a7c616efb995539c 100644
--- a/libs/nativewindow/include/android/data_space.h
+++ b/libs/nativewindow/include/android/data_space.h
@@ -38,7 +38,7 @@ __BEGIN_DECLS
 /**
  * ADataSpace.
  */
-enum ADataSpace : int32_t {
+enum ADataSpace {
     /**
      * Default-assumption data space, when not explicitly specified.
      *
diff --git a/libs/nativewindow/include/android/native_window.h b/libs/nativewindow/include/android/native_window.h
index d6620f3b1c029dff4f3f3f3435f812046b3981b2..2c7979b86f73fc0d4bd0be8f5135e5645d898eb7 100644
--- a/libs/nativewindow/include/android/native_window.h
+++ b/libs/nativewindow/include/android/native_window.h
@@ -378,7 +378,9 @@ int32_t ANativeWindow_setFrameRateWithChangeStrategy(ANativeWindow* _Nonnull win
  *
  * \return 0 for success, -EINVAL if the window value is invalid.
  */
-inline int32_t ANativeWindow_clearFrameRate(ANativeWindow* _Nonnull window) __INTRODUCED_IN(31) {
+inline int32_t ANativeWindow_clearFrameRate(ANativeWindow* _Nonnull window) __INTRODUCED_IN(31);
+
+inline int32_t ANativeWindow_clearFrameRate(ANativeWindow* _Nonnull window) {
     return ANativeWindow_setFrameRateWithChangeStrategy(window, 0,
             ANATIVEWINDOW_FRAME_RATE_COMPATIBILITY_DEFAULT,
             ANATIVEWINDOW_CHANGE_FRAME_RATE_ONLY_IF_SEAMLESS);
diff --git a/libs/nativewindow/include/vndk/hardware_buffer.h b/libs/nativewindow/include/vndk/hardware_buffer.h
index eb3fd6e15d53d49d78b330e000f35d2e6bd22526..5ab24ddc0acf8525b6ce2c9755dc4dd6c143846b 100644
--- a/libs/nativewindow/include/vndk/hardware_buffer.h
+++ b/libs/nativewindow/include/vndk/hardware_buffer.h
@@ -117,7 +117,7 @@ typedef struct {
     int64_t value;
 } AHardwareBufferLongOptions;
 
-enum AHardwareBufferStatus : int32_t {
+enum AHardwareBufferStatus {
     /* Success, no error */
     AHARDWAREBUFFER_STATUS_OK = 0,
     /* There's insufficient memory to satisfy the request */
