From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rinigus <rinigus.git@gmail.com>
Date: Wed, 15 Oct 2025 20:43:17 +0300
Subject: [PATCH] (hybris) Add kernel wakelock to reflect Android wakelock
 requests

Android prevents suspend using its internal service in addition to kernel wakelocks. Add
wakelock reflecting the status of Android service and preventing suspend in kernel autosuspend
mode

Change-Id: I1914acb2d5d152f7c6ee5706c5828af0749866bc
---
 suspend/aidl/default/SystemSuspend.cpp                | 11 +++++++++++
 .../aidl/default/android.system.suspend-service.rc    |  2 +-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/suspend/aidl/default/SystemSuspend.cpp b/suspend/aidl/default/SystemSuspend.cpp
index 5e16ebacc494cc68f3919574679e6e5ae7c01e48..9d5870ed30550f0ce5970c28ebb935c4dd4e995c 100644
--- a/suspend/aidl/default/SystemSuspend.cpp
+++ b/suspend/aidl/default/SystemSuspend.cpp
@@ -84,6 +84,9 @@ static constexpr char kSysModuleSuspendPmFsAbort[] = "/sys/module/suspend/parame
 // rootdir/init.zygote64_32.rc
 static constexpr char kZygoteKernelWakelock[] = "zygote_kwl";
 
+// Autosuspend wakelock: locked when counter is higher than zero
+static constexpr char kAndroidSuspendKernelWakelock[] = "android_suspend_service";
+
 // This function assumes that data in fd is small enough that it can be read in one go.
 // We use this function instead of the ones available in libbase because it doesn't block
 // indefinitely when reading from socket streams which are used for testing.
@@ -301,6 +304,11 @@ void SystemSuspend::incSuspendCounter(const string& name) {
     WriteStringToFd(kUserspaceAbort, mWakeLockFd);
     auto l = std::lock_guard(mAutosuspendLock);
     if (mUseSuspendCounter) {
+        if (mSuspendCounter == 0) {
+            if (!WriteStringToFd(kAndroidSuspendKernelWakelock, mWakeLockFd)) {
+                PLOG(ERROR) << "error writing " << kAndroidSuspendKernelWakelock << " to " << kSysPowerWakeLock;
+            }
+        }
         mSuspendCounter++;
     } else {
         if (!WriteStringToFd(name, mWakeLockFd)) {
@@ -318,6 +326,9 @@ void SystemSuspend::decSuspendCounter(const string& name) {
     auto l = std::lock_guard(mAutosuspendLock);
     if (mUseSuspendCounter) {
         if (--mSuspendCounter == 0) {
+            if (!WriteStringToFd(kAndroidSuspendKernelWakelock, mWakeUnlockFd)) {
+                PLOG(ERROR) << "error writing " << kAndroidSuspendKernelWakelock << " to " << kSysPowerWakeUnlock;
+            }
             mAutosuspendCondVar.notify_one();
         }
     } else {
diff --git a/suspend/aidl/default/android.system.suspend-service.rc b/suspend/aidl/default/android.system.suspend-service.rc
index 6aa9de6c06f918da3e52cad0e74d754ee24c919d..b385d05aeab726928e5ef890c9d3ac73ae574383 100644
--- a/suspend/aidl/default/android.system.suspend-service.rc
+++ b/suspend/aidl/default/android.system.suspend-service.rc
@@ -1,4 +1,4 @@
-service system_suspend /system/bin/hw/android.system.suspend-service
+service system_suspend /usr/libexec/droid-hybris/system/bin/hw/android.system.suspend-service
     class early_hal
     user system
     group system wakelock
