From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Ghosal <Martin.Ghosal@sky.uk>
Date: Sun, 8 Jan 2017 16:34:54 +0000
Subject: [PATCH] (hybris) Disable all zygote variations

Change-Id: Ie1ad26486f47b3bf67134db917b3c9e51536904c
---
 rootdir/init.rc             | 6 +++---
 rootdir/init.zygote32.rc    | 1 +
 rootdir/init.zygote64.rc    | 1 +
 rootdir/init.zygote64_32.rc | 3 ++-
 4 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index d251d4cfeeb571165f2cfead79912ee7d0327922..650b347dcc90d591e86920ff716aa80df4af0452 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -16,7 +16,7 @@ import /init.environ.rc
 import /init.${ro.hardware}.rc
 import /vendor/etc/init/hw/init.${ro.hardware}.rc
 import /system/etc/init/hw/init.usb.configfs.rc
-import /system/etc/init/hw/init.${ro.zygote}.rc
+import /usr/libexec/droid-hybris/system/etc/init/hw/init.${ro.zygote}.rc
 
 # Cgroups are mounted right before early-init using list from /etc/cgroups.json
 on early-init
@@ -556,7 +556,7 @@ on late-init
     trigger load_bpf_programs
 
     # Now we can start zygote.
-    trigger zygote-start
+    #trigger zygote-start
 
     # Remove a file to wake up anything waiting for firmware.
     trigger firmware_mounts_complete
@@ -1353,7 +1353,7 @@ on userspace-reboot-fs-remount
 on userspace-reboot-resume
   trigger userspace-reboot-fs-remount
   trigger post-fs-data
-  trigger zygote-start
+  #trigger zygote-start
   trigger early-boot
   trigger boot
 
diff --git a/rootdir/init.zygote32.rc b/rootdir/init.zygote32.rc
index 442bd153f5dbda0592db6451a500c8318c281c6c..0fbfb6ab09e439890b71d40fdf64d988118d4120 100644
--- a/rootdir/init.zygote32.rc
+++ b/rootdir/init.zygote32.rc
@@ -18,3 +18,4 @@ service zygote /system/bin/app_process -Xzygote /system/bin --zygote --start-sys
     onrestart restart wificond
     task_profiles ProcessCapacityHigh
     critical window=${zygote.critical_window.minute:-off} target=zygote-fatal
+    disabled
\ No newline at end of file
diff --git a/rootdir/init.zygote64.rc b/rootdir/init.zygote64.rc
index 342212123de59bebaf3eb4d4c3dca7147affe5c4..d770078794d7407d547607b6d274af5e9afb95bf 100644
--- a/rootdir/init.zygote64.rc
+++ b/rootdir/init.zygote64.rc
@@ -18,3 +18,4 @@ service zygote /system/bin/app_process64 -Xzygote /system/bin --zygote --start-s
     onrestart restart wificond
     task_profiles ProcessCapacityHigh MaxPerformance
     critical window=${zygote.critical_window.minute:-off} target=zygote-fatal
+    disabled
diff --git a/rootdir/init.zygote64_32.rc b/rootdir/init.zygote64_32.rc
index 109bf6c65cb22d3706e6a5c6b20daa307611cc7d..8eb6eb0b8b1558ac3db6455e654887c11f10e487 100644
--- a/rootdir/init.zygote64_32.rc
+++ b/rootdir/init.zygote64_32.rc
@@ -1,4 +1,4 @@
-import /system/etc/init/hw/init.zygote64.rc
+import /usr/libexec/droid-hybris/system/etc/init/hw/init.zygote64.rc
 
 service zygote_secondary /system/bin/app_process32 -Xzygote /system/bin --zygote --socket-name=zygote_secondary --enable-lazy-preload
     class main
@@ -9,3 +9,4 @@ service zygote_secondary /system/bin/app_process32 -Xzygote /system/bin --zygote
     socket usap_pool_secondary stream 660 root system
     onrestart restart zygote
     task_profiles ProcessCapacityHigh MaxPerformance
+    disabled
