Subject: [PATCH] (hybris) Set ro.cold_boot_done property at end of early init.

Change-Id: I8fb92845d47ef286005944150e2fa3ea366ebcbf
---
 rootdir/init.rc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index 7f0b9fe6dacc371b0b6220019e3978a5da903690..5999f8d3b5aa780375d87281fbe27f6119346f31 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -91,6 +91,8 @@ on early-init
     # checker programs.
     mkdir /dev/fscklogs 0770 root system
 
+    setprop ro.cold_boot_done true
+
 on init
     sysclktz 0
 
