Date: Sat, 2 Oct 2021 23:17:17 +0000
Subject: [PATCH] (hybris) Set ro.cold_boot_done property at end of early init.

Change-Id: I8fb92845d47ef286005944150e2fa3ea366ebcbf
---
 rootdir/init.rc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index b06acd66088f143e188b50da8b815d6d4d8e564c..de8544f8aac9f2db598d3f457fa8ef185f6f4ab0 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -112,6 +112,8 @@ on early-init
 on early-init && property:ro.boot.bootchart.enabled=""
     rmdir /dev/bootchart
 
+    setprop ro.cold_boot_done true
+
 on init
     sysclktz 0
 
