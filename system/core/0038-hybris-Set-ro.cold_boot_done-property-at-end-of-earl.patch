Date: Sat, 2 Oct 2021 23:17:17 +0000
Subject: [PATCH] (hybris) Set ro.cold_boot_done property at end of early init.

Change-Id: I8fb92845d47ef286005944150e2fa3ea366ebcbf
---
 rootdir/init.rc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index ff795ad162eabe19de7efd77bbb2a399f5ef2aff..872ef902f94178bea694fc780f11d1666ffdb124 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -97,6 +97,8 @@ on early-init
     chown shell shell /tmp
     chmod 0771 /tmp
 
+    setprop ro.cold_boot_done true
+
 on init
     sysclktz 0
 
