From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Matti=20Lehtim=C3=A4ki?= <matti.lehtimaki@gmail.com>
Date: Sat, 6 Aug 2016 11:37:38 +0300
Subject: [PATCH] (hybris) Disable setting hostname and domainname in init.rc.

Change-Id: I5b9f59e80760e53636763c89f8f76f350c17b3ec
---
 rootdir/init.rc | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index e6004720b1ff16a4550bb6d75ce25153ee82e301..d251d4cfeeb571165f2cfead79912ee7d0327922 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -1101,8 +1101,9 @@ on boot && property:suspend.disable_sync_on_suspend=true
 on boot
     # basic network init
     ifup lo
-    hostname localhost
-    domainname localdomain
+# Conflicts with Mer
+    #hostname localhost
+    #domainname localdomain
 
     # IPsec SA default expiration length
     write /proc/sys/net/core/xfrm_acq_expires 3600
