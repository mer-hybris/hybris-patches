 rootdir/init.rc | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index 58e40dd7c27ca0a3e81af0628fbf0b98b9cc1cb4..3bd67dfc8b8d765fed3535b2a9dac192235d3f9f 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -586,7 +586,7 @@ on late-init
 
 on early-fs
     # Once metadata has been mounted, we'll need vold to deal with userdata checkpointing
-    start vold
+    #start vold
 
 on post-fs
     exec - system system -- /system/bin/vdc checkpoint markBootAttempt
@@ -706,6 +706,8 @@ on post-fs-data
     restorecon /data
 
     # Make sure we have the device encryption key.
+    # hybris continue bootup properly
+    setprop vold.decrypt trigger_restart_min_framework
     installkey /data
 
     # Start bootcharting as soon as possible after the data partition is
