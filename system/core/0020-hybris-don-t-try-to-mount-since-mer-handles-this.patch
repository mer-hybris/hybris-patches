---
 init/first_stage_mount.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/init/first_stage_mount.cpp b/init/first_stage_mount.cpp
index 0148a5a29899e72106b84923ce0dd8475c3cefa4..1dc08d8e359c05eadf7a3cb88b5c15bc30b9796b 100644
--- a/init/first_stage_mount.cpp
+++ b/init/first_stage_mount.cpp
@@ -263,6 +263,7 @@ bool FirstStageMountVBootV2::DoCreateDevices() {
 }
 
 bool FirstStageMountVBootV2::DoFirstStageMount() {
+#if DISABLED_FOR_HYBRIS_SUPPORT
     if (!IsDmLinearEnabled() && fstab_.empty()) {
         // Nothing to mount.
         LOG(INFO) << "First stage mount skipped (missing/incompatible/empty fstab in device tree)";
@@ -271,6 +272,7 @@ bool FirstStageMountVBootV2::DoFirstStageMount() {
 
     if (!MountPartitions()) return false;
 
+#endif
     return true;
 }
 
