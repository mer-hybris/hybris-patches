                 {"help", no_argument, nullptr, 'h'},
                 {kPropertyContexts, required_argument, nullptr, 0},
-                {"out_system", required_argument, nullptr, 0},
-                {"out_system_ext", required_argument, nullptr, 0},
-                {"out_odm", required_argument, nullptr, 0},
