From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matti Lehtimaki <matti.lehtimaki@gmail.com>
Date: Sun, 17 Nov 2024 05:47:36 +0200
Subject: [PATCH] (hybris) Do not change permissions or /tmp

Change-Id: Ib4fd846ba003a66acb88c34bd33a6f3e3e2335b4
---
 rootdir/init.rc | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index ab9aca99d4c2140fb8e8b970dfa091a26abf981a..5c6caaed303289c6b4525e9378416343b5bb8611 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -105,9 +105,10 @@ on early-init
 
     # Create tmpfs for use by the shell user.
     mount tmpfs tmpfs /tmp
-    restorecon /tmp
-    chown shell shell /tmp
-    chmod 0771 /tmp
+    # hybris handles /tmp
+    #restorecon /tmp
+    #chown shell shell /tmp
+    #chmod 0771 /tmp
 
 on early-init && property:ro.boot.bootchart.enabled=""
     rmdir /dev/bootchart
