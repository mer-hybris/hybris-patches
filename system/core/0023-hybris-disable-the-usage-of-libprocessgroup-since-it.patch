From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Franz-Josef Haider <franz.haider@jolla.com>
Date: Wed, 6 Jun 2018 09:33:03 +0200
Subject: [PATCH] (hybris) disable the usage of libprocessgroup, since it is
 incompatible.

Change-Id: Ie37ac0dcc5cabbf33de55c148009fdfff3e90c64
---
 init/Android.bp  |  4 ----
 init/init.cpp    |  2 --
 init/service.cpp | 19 +++++++++++++++++--
 3 files changed, 17 insertions(+), 8 deletions(-)

diff --git a/init/Android.bp b/init/Android.bp
index e5512e62652c1a63041d249ddf86679800c56a8a..be1e30cbbefaf819be14bf7fb9a4dfc3c302a728 100644
--- a/init/Android.bp
+++ b/init/Android.bp
@@ -192,8 +192,6 @@ libinit_cc_defaults {
         "liblog",
         "liblogwrap",
         "liblp",
-        "libprocessgroup",
-        "libprocessgroup_setup",
         "libselinux",
         "libunwindstack",
         "libutils",
@@ -528,7 +526,6 @@ cc_defaults {
         "libcutils",
         "libselinux",
         "liblog",
-        "libprocessgroup",
         "libprotobuf-cpp-lite",
     ],
     static_libs: [
@@ -591,7 +588,6 @@ cc_defaults {
         "libhidl-gen-utils",
         "libhidlmetadata",
         "liblog",
-        "libprocessgroup",
         "libprotobuf-cpp-lite",
     ],
     proto: {
diff --git a/init/init.cpp b/init/init.cpp
index 9309d001c6d7e7937c39415a7cd4fd21be06ace9..8418801928c1ac3fdcc1eb62ee2ed52e525a90e4 100644
--- a/init/init.cpp
+++ b/init/init.cpp
@@ -59,8 +59,6 @@
 #include <libgsi/libgsi.h>
 #include <libsnapshot/snapshot.h>
 #include <logwrap/logwrap.h>
-#include <processgroup/processgroup.h>
-#include <processgroup/setup.h>
 #include <selinux/android.h>
 #include <unwindstack/AndroidUnwinder.h>
 
diff --git a/init/service.cpp b/init/service.cpp
index bd6643ea99692298eb3732f792846f4f88b1edc6..2f01aa8b142d18a38efd589e897b771ac31ecb2d 100644
--- a/init/service.cpp
+++ b/init/service.cpp
@@ -35,7 +35,6 @@
 #include <android-base/stringprintf.h>
 #include <android-base/strings.h>
 #include <cutils/sockets.h>
-#include <processgroup/processgroup.h>
 #include <selinux/selinux.h>
 #include <sys/signalfd.h>
 
@@ -208,7 +207,13 @@ void Service::KillProcessGroup(int signal) {
     // These signals must be sent for a successful shutdown.
     if (!process_cgroup_empty_ || IsRunning()) {
         LOG(INFO) << "Sending signal " << signal << " to service '" << name_ << "' (pid " << pid_
-                  << ") process group...";
+                  << ") process group... HYBRIS: killing PID instead of process group.";
+
+        kill(pid_, signal);
+
+// hybris: TODO?
+#if DISABLED_FOR_HYBRIS_SUPPORT
+
         int r;
         if (signal == SIGTERM) {
             r = killProcessGroupOnce(uid(), pid_, signal);
@@ -217,6 +222,8 @@ void Service::KillProcessGroup(int signal) {
         }
 
         if (r == 0) process_cgroup_empty_ = true;
+#endif
+        process_cgroup_empty_ = true;
     }
 
     if (oom_score_adjust_ != DEFAULT_OOM_SCORE_ADJUST) {
@@ -300,9 +307,11 @@ void Service::Reap(const siginfo_t& siginfo) {
 
     if (flags_ & SVC_EXEC) UnSetExec();
 
+#if DISABLED_FOR_HYBRIS_SUPPORT
     if (name_ == "zygote" || name_ == "zygote64") {
         removeAllEmptyProcessGroups();
     }
+#endif
 
     if (flags_ & SVC_TEMPORARY) return;
 
@@ -478,6 +487,7 @@ Result<void> Service::CheckConsole() {
 
 // Configures the memory cgroup properties for the service.
 void Service::ConfigureMemcg() {
+#if DISABLED_FOR_HYBRIS_SUPPORT
     if (swappiness_ != -1) {
         if (!setProcessGroupSwappiness(uid(), pid_, swappiness_)) {
             PLOG(ERROR) << "setProcessGroupSwappiness failed";
@@ -516,6 +526,7 @@ void Service::ConfigureMemcg() {
             PLOG(ERROR) << "setProcessGroupLimit failed";
         }
     }
+#endif
 }
 
 // Enters namespaces, sets environment variables, writes PID files and runs the service executable.
@@ -536,6 +547,7 @@ void Service::RunService(const std::vector<Descriptor>& descriptors,
         descriptor.Publish();
     }
 
+#if DISABLED_FOR_HYBRIS_SUPPORT
     if (auto result = WritePidToFiles(&writepid_files_); !result.ok()) {
         LOG(ERROR) << "failed to write pid to files: " << result.error();
     }
@@ -565,6 +577,7 @@ void Service::RunService(const std::vector<Descriptor>& descriptors,
             LOG(ERROR) << "failed to set task profiles";
         }
     }
+#endif
 
     // As requested, set our gid, supplemental gids, uid, context, and
     // priority. Aborts on failure.
@@ -708,6 +721,7 @@ Result<void> Service::Start() {
     start_order_ = next_start_order_++;
     process_cgroup_empty_ = false;
 
+#if DISABLED_FOR_HYBRIS_SUPPORT
     if (CgroupsAvailable()) {
         bool use_memcg = swappiness_ != -1 || soft_limit_in_bytes_ != -1 || limit_in_bytes_ != -1 ||
                          limit_percent_ != -1 || !limit_property_.empty();
@@ -767,6 +781,7 @@ Result<void> Service::Start() {
     }
 
     setsid_finished.Close();
+#endif
 
     NotifyStateChange("running");
     reboot_on_failure.Disable();
